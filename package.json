{
  "name": "macsweep",
  "version": "1.0.0",
  "description": "MacSweep — real-time macOS optimisation dashboard with safe cleanup, local + remote (SSH/Tailscale).",
  "author": "MacSweep",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "electron-vite build && electron out/main/index.js --smoke-test"
  },
  "dependencies": {
    "node-ssh": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "postcss": "8.5.18",
    "browserslist": "4.28.7"
  }
}
